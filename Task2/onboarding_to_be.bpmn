<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_VitaStore" targetNamespace="http://vitastore.ru/bpmn" exporter="hand-generated" exporterVersion="1.0">
<bpmn:collaboration id="Collab_Onboarding">
<bpmn:participant id="P_store" name="Купленный магазин (директор / старший кассир)" processRef="Proc_P_store"/>
<bpmn:participant id="P_hq" name="VitaStore HQ — сотрудники" processRef="Proc_P_hq"/>
<bpmn:participant id="P_plat" name="Платформа онбординга (iPaaS / ETL) — система" processRef="Proc_P_plat"/>
<bpmn:participant id="P_ai" name="ИИ-сервис SKU Matching — система" processRef="Proc_P_ai"/>
<bpmn:participant id="P_sap" name="SAP ERP (MDM, цены) — система" processRef="Proc_P_sap"/>
<bpmn:participant id="P_pos" name="Cloud POS (SaaS) — система" processRef="Proc_P_pos"/>
<bpmn:messageFlow id="MF_0" name="Приглашение + чек-лист" sourceRef="m_send" targetRef="s_start"/>
<bpmn:messageFlow id="MF_1" name="Файл выгрузки" sourceRef="s_upload" targetRef="p_start"/>
<bpmn:messageFlow id="MF_2" name="Отчёт об ошибках" sourceRef="p_req" targetRef="s_upload"/>
<bpmn:messageFlow id="MF_3" name="Пакет SKU" sourceRef="p_toai" targetRef="a_start"/>
<bpmn:messageFlow id="MF_4" name="Кандидаты + score" sourceRef="a_end" targetRef="p_res"/>
<bpmn:messageFlow id="MF_5" name="Очередь задач" sourceRef="p_hitl" targetRef="t_start"/>
<bpmn:messageFlow id="MF_6" name="Решения" sourceRef="t_end" targetRef="p_hres"/>
<bpmn:messageFlow id="MF_7" name="Таблица соответствий" sourceRef="p_end" targetRef="e_start"/>
<bpmn:messageFlow id="MF_8" name="Каталог и цены" sourceRef="e_end" targetRef="c_start"/>
<bpmn:messageFlow id="MF_9" name="Готовность кассы" sourceRef="c_end" targetRef="s_wait"/>
<bpmn:messageFlow id="MF_10" name="Отчёт" sourceRef="s_end" targetRef="m_wait"/>
<bpmn:association id="AS_0" sourceRef="n_thr" targetRef="p_ig"/>
<bpmn:association id="AS_1" sourceRef="n_sla" targetRef="a_sem"/>
<bpmn:textAnnotation id="n_thr"><bpmn:text>Точка верификации: ≥ 95% → авто; 70–95% → проверка; &lt; 70% → новая карточка</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="n_sla"><bpmn:text>SLA этапа: минуты–часы вместо 2 недель ручного труда</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="Proc_P_store" name="Подготовка магазина" isExecutable="false">
<bpmn:startEvent id="s_start" name="Получено приглашение на портал"><bpmn:outgoing>SF_s_start__s_upload</bpmn:outgoing><bpmn:messageEventDefinition id="MED_s_start"/></bpmn:startEvent>
<bpmn:task id="s_upload" name="Выгрузить номенклатуру и остатки утилитой-коннектором (или загрузить файл любого формата)"><bpmn:incoming>SF_s_start__s_upload</bpmn:incoming><bpmn:outgoing>SF_s_upload__s_kit</bpmn:outgoing><bpmn:dataOutputAssociation id="DOA_s_upload_s_file"><bpmn:targetRef>s_file</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task>
<bpmn:task id="s_kit" name="Подключить комплект Cloud POS: планшет + HAL (zero-touch)"><bpmn:incoming>SF_s_upload__s_kit</bpmn:incoming><bpmn:outgoing>SF_s_kit__s_wait</bpmn:outgoing></bpmn:task>
<bpmn:intermediateCatchEvent id="s_wait" name="Каталог и цены опубликованы"><bpmn:incoming>SF_s_kit__s_wait</bpmn:incoming><bpmn:outgoing>SF_s_wait__s_test</bpmn:outgoing><bpmn:messageEventDefinition id="MED_s_wait"/></bpmn:intermediateCatchEvent>
<bpmn:task id="s_test" name="Пробная продажа: 20 случайных товаров, сверка ценников"><bpmn:incoming>SF_s_wait__s_test</bpmn:incoming><bpmn:outgoing>SF_s_test__s_end</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="s_end" name="Результат пробной продажи отправлен"><bpmn:incoming>SF_s_test__s_end</bpmn:incoming><bpmn:messageEventDefinition id="MED_s_end"/></bpmn:endEvent>
<bpmn:dataObject id="DO_s_file"/>
<bpmn:dataObjectReference id="s_file" name="Выгрузка номенклатуры (CSV / XLS / дамп БД)" dataObjectRef="DO_s_file"/>
<bpmn:sequenceFlow id="SF_s_start__s_upload" sourceRef="s_start" targetRef="s_upload"/>
<bpmn:sequenceFlow id="SF_s_upload__s_kit" sourceRef="s_upload" targetRef="s_kit"/>
<bpmn:sequenceFlow id="SF_s_kit__s_wait" sourceRef="s_kit" targetRef="s_wait"/>
<bpmn:sequenceFlow id="SF_s_wait__s_test" sourceRef="s_wait" targetRef="s_test"/>
<bpmn:sequenceFlow id="SF_s_test__s_end" sourceRef="s_test" targetRef="s_end"/>
</bpmn:process>
<bpmn:process id="Proc_P_hq" name="Управление онбордингом" isExecutable="false">
<bpmn:laneSet id="LS_P_hq">
<bpmn:lane id="L_mgr" name="Менеджер интеграции (M&amp;A / ИТ)">
<bpmn:flowNodeRef>m_start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_reg</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_send</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_wait</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_gw</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_fix</bpmn:flowNodeRef>
<bpmn:flowNodeRef>m_end</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_stw" name="Товаровед (Data Steward)">
<bpmn:flowNodeRef>t_start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_new</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_audit</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_end</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="m_start" name="Сделка M&amp;A закрыта, магазин передан на интеграцию"><bpmn:outgoing>SF_m_start__m_reg</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="m_reg" name="Зарегистрировать магазин в портале онбординга (анкета: ККТ, терминалы, учётная система)"><bpmn:incoming>SF_m_start__m_reg</bpmn:incoming><bpmn:outgoing>SF_m_reg__m_send</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="m_send" name="Отправить магазину ссылку на портал и заказать комплект Cloud POS"><bpmn:incoming>SF_m_reg__m_send</bpmn:incoming><bpmn:outgoing>SF_m_send__m_wait</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="m_wait" name="Отчёт о пробной продаже получен"><bpmn:incoming>SF_m_send__m_wait</bpmn:incoming><bpmn:outgoing>SF_m_wait__m_gw</bpmn:outgoing><bpmn:messageEventDefinition id="MED_m_wait"/></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="m_gw" name="Расхождения есть?"><bpmn:incoming>SF_m_wait__m_gw</bpmn:incoming><bpmn:outgoing>SF_m_gw__m_end</bpmn:outgoing><bpmn:outgoing>SF_m_gw__m_fix</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="m_fix" name="Точечно исправить карточки в MDM вместе с товароведом"><bpmn:incoming>SF_m_gw__m_fix</bpmn:incoming><bpmn:outgoing>SF_m_fix__m_end</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="m_end" name="Магазин открыт под брендом VitaStore (≤ 5 дней)"><bpmn:incoming>SF_m_gw__m_end</bpmn:incoming><bpmn:incoming>SF_m_fix__m_end</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="t_start" name="Задачи верификации получены"><bpmn:outgoing>SF_t_start__t_check</bpmn:outgoing><bpmn:messageEventDefinition id="MED_t_start"/></bpmn:startEvent>
<bpmn:userTask id="t_check" name="Проверить кандидатов (UI: топ-3, фото, цена; 4 глаза для дорогих SKU)"><bpmn:incoming>SF_t_start__t_check</bpmn:incoming><bpmn:outgoing>SF_t_check__t_new</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t_new" name="Завести новые карточки SKU для позиций без кандидата (&lt; 70%)"><bpmn:incoming>SF_t_check__t_new</bpmn:incoming><bpmn:outgoing>SF_t_new__t_audit</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t_audit" name="Проверить случайную выборку 3% автоподтверждений"><bpmn:incoming>SF_t_new__t_audit</bpmn:incoming><bpmn:outgoing>SF_t_audit__t_end</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="t_end" name="Решения отправлены"><bpmn:incoming>SF_t_audit__t_end</bpmn:incoming><bpmn:messageEventDefinition id="MED_t_end"/></bpmn:endEvent>
<bpmn:sequenceFlow id="SF_m_start__m_reg" sourceRef="m_start" targetRef="m_reg"/>
<bpmn:sequenceFlow id="SF_m_reg__m_send" sourceRef="m_reg" targetRef="m_send"/>
<bpmn:sequenceFlow id="SF_t_start__t_check" sourceRef="t_start" targetRef="t_check"/>
<bpmn:sequenceFlow id="SF_t_check__t_new" sourceRef="t_check" targetRef="t_new"/>
<bpmn:sequenceFlow id="SF_t_new__t_audit" sourceRef="t_new" targetRef="t_audit"/>
<bpmn:sequenceFlow id="SF_t_audit__t_end" sourceRef="t_audit" targetRef="t_end"/>
<bpmn:sequenceFlow id="SF_m_wait__m_gw" sourceRef="m_wait" targetRef="m_gw"/>
<bpmn:sequenceFlow id="SF_m_gw__m_end" name="Нет" sourceRef="m_gw" targetRef="m_end"/>
<bpmn:sequenceFlow id="SF_m_gw__m_fix" name="Да" sourceRef="m_gw" targetRef="m_fix"/>
<bpmn:sequenceFlow id="SF_m_fix__m_end" sourceRef="m_fix" targetRef="m_end"/>
<bpmn:sequenceFlow id="SF_m_send__m_wait" sourceRef="m_send" targetRef="m_wait"/>
</bpmn:process>
<bpmn:process id="Proc_P_plat" name="Конвейер миграции данных" isExecutable="false">
<bpmn:startEvent id="p_start" name="Файл получен"><bpmn:outgoing>SF_p_start__p_parse</bpmn:outgoing><bpmn:messageEventDefinition id="MED_p_start"/></bpmn:startEvent>
<bpmn:serviceTask id="p_parse" name="Парсинг и нормализация: кодировки, единицы, бренды, штрихкоды"><bpmn:incoming>SF_p_start__p_parse</bpmn:incoming><bpmn:incoming>SF_p_recv__p_parse</bpmn:incoming><bpmn:outgoing>SF_p_parse__p_dq</bpmn:outgoing></bpmn:serviceTask>
<bpmn:businessRuleTask id="p_dq" name="DQ-проверка: дубли, пустые ШК, цены, обязательные поля"><bpmn:incoming>SF_p_parse__p_dq</bpmn:incoming><bpmn:outgoing>SF_p_dq__p_gw1</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="p_gw1" name="Качество данных достаточное?"><bpmn:incoming>SF_p_dq__p_gw1</bpmn:incoming><bpmn:outgoing>SF_p_gw1__p_toai</bpmn:outgoing><bpmn:outgoing>SF_p_gw1__p_req</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="p_req" name="Запросить исправленную выгрузку (отчёт об ошибках)"><bpmn:incoming>SF_p_gw1__p_req</bpmn:incoming><bpmn:outgoing>SF_p_req__p_recv</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="p_recv" name="Исправленный файл получен"><bpmn:incoming>SF_p_req__p_recv</bpmn:incoming><bpmn:outgoing>SF_p_recv__p_parse</bpmn:outgoing><bpmn:messageEventDefinition id="MED_p_recv"/></bpmn:intermediateCatchEvent>
<bpmn:sendTask id="p_toai" name="Передать пакет SKU в ИИ-сервис"><bpmn:incoming>SF_p_gw1__p_toai</bpmn:incoming><bpmn:outgoing>SF_p_toai__p_res</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="p_res" name="Результаты маппинга получены"><bpmn:incoming>SF_p_toai__p_res</bpmn:incoming><bpmn:outgoing>SF_p_res__p_split</bpmn:outgoing><bpmn:messageEventDefinition id="MED_p_res"/></bpmn:intermediateCatchEvent>
<bpmn:businessRuleTask id="p_split" name="Разделить пакет по confidence и бизнес-правилам"><bpmn:incoming>SF_p_res__p_split</bpmn:incoming><bpmn:outgoing>SF_p_split__p_ig</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:inclusiveGateway id="p_ig" name="Маршрут по уверенности"><bpmn:incoming>SF_p_split__p_ig</bpmn:incoming><bpmn:outgoing>SF_p_ig__p_auto</bpmn:outgoing><bpmn:outgoing>SF_p_ig__p_hitl</bpmn:outgoing></bpmn:inclusiveGateway>
<bpmn:serviceTask id="p_auto" name="Автоподтвердить (≥ 95% и правила пройдены), отобрать 3% на аудит"><bpmn:incoming>SF_p_ig__p_auto</bpmn:incoming><bpmn:outgoing>SF_p_auto__p_join</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sendTask id="p_hitl" name="Поставить задачи товароведу (&lt; 95% или нарушено правило)"><bpmn:incoming>SF_p_ig__p_hitl</bpmn:incoming><bpmn:outgoing>SF_p_hitl__p_hres</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="p_hres" name="Решения товароведа получены"><bpmn:incoming>SF_p_hitl__p_hres</bpmn:incoming><bpmn:outgoing>SF_p_hres__p_join</bpmn:outgoing><bpmn:messageEventDefinition id="MED_p_hres"/></bpmn:intermediateCatchEvent>
<bpmn:inclusiveGateway id="p_join" name=""><bpmn:incoming>SF_p_auto__p_join</bpmn:incoming><bpmn:incoming>SF_p_hres__p_join</bpmn:incoming><bpmn:outgoing>SF_p_join__p_table</bpmn:outgoing></bpmn:inclusiveGateway>
<bpmn:serviceTask id="p_table" name="Собрать таблицу соответствий + аудит-лог, вернуть решения в обучающую выборку"><bpmn:incoming>SF_p_join__p_table</bpmn:incoming><bpmn:outgoing>SF_p_table__p_end</bpmn:outgoing><bpmn:dataOutputAssociation id="DOA_p_table_p_map"><bpmn:targetRef>p_map</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="p_end" name="Пакет передан в SAP"><bpmn:incoming>SF_p_table__p_end</bpmn:incoming><bpmn:messageEventDefinition id="MED_p_end"/></bpmn:endEvent>
<bpmn:dataObject id="DO_p_map"/>
<bpmn:dataObjectReference id="p_map" name="Таблица соответствий SKU" dataObjectRef="DO_p_map"/>
<bpmn:sequenceFlow id="SF_p_start__p_parse" sourceRef="p_start" targetRef="p_parse"/>
<bpmn:sequenceFlow id="SF_p_parse__p_dq" sourceRef="p_parse" targetRef="p_dq"/>
<bpmn:sequenceFlow id="SF_p_dq__p_gw1" sourceRef="p_dq" targetRef="p_gw1"/>
<bpmn:sequenceFlow id="SF_p_gw1__p_toai" name="Да" sourceRef="p_gw1" targetRef="p_toai"/>
<bpmn:sequenceFlow id="SF_p_gw1__p_req" name="Нет" sourceRef="p_gw1" targetRef="p_req"/>
<bpmn:sequenceFlow id="SF_p_req__p_recv" sourceRef="p_req" targetRef="p_recv"/>
<bpmn:sequenceFlow id="SF_p_recv__p_parse" sourceRef="p_recv" targetRef="p_parse"/>
<bpmn:sequenceFlow id="SF_p_toai__p_res" sourceRef="p_toai" targetRef="p_res"/>
<bpmn:sequenceFlow id="SF_p_res__p_split" sourceRef="p_res" targetRef="p_split"/>
<bpmn:sequenceFlow id="SF_p_split__p_ig" sourceRef="p_split" targetRef="p_ig"/>
<bpmn:sequenceFlow id="SF_p_ig__p_auto" name="≥ 95%" sourceRef="p_ig" targetRef="p_auto"/>
<bpmn:sequenceFlow id="SF_p_ig__p_hitl" name="&lt; 95%" sourceRef="p_ig" targetRef="p_hitl"/>
<bpmn:sequenceFlow id="SF_p_hitl__p_hres" sourceRef="p_hitl" targetRef="p_hres"/>
<bpmn:sequenceFlow id="SF_p_auto__p_join" sourceRef="p_auto" targetRef="p_join"/>
<bpmn:sequenceFlow id="SF_p_hres__p_join" sourceRef="p_hres" targetRef="p_join"/>
<bpmn:sequenceFlow id="SF_p_join__p_table" sourceRef="p_join" targetRef="p_table"/>
<bpmn:sequenceFlow id="SF_p_table__p_end" sourceRef="p_table" targetRef="p_end"/>
</bpmn:process>
<bpmn:process id="Proc_P_ai" name="Автоматический маппинг SKU" isExecutable="false">
<bpmn:startEvent id="a_start" name="Пакет SKU получен"><bpmn:outgoing>SF_a_start__a_exact</bpmn:outgoing><bpmn:messageEventDefinition id="MED_a_start"/></bpmn:startEvent>
<bpmn:serviceTask id="a_exact" name="Точное совпадение по GTIN/EAN с эталоном"><bpmn:incoming>SF_a_start__a_exact</bpmn:incoming><bpmn:outgoing>SF_a_exact__a_sem</bpmn:outgoing><bpmn:dataInputAssociation id="DIA_a_ref_a_exact"><bpmn:sourceRef>a_ref</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:serviceTask id="a_sem" name="Поиск кандидатов: эмбеддинги + LLM-разбор (бренд, линейка, объём)"><bpmn:incoming>SF_a_exact__a_sem</bpmn:incoming><bpmn:outgoing>SF_a_sem__a_score</bpmn:outgoing><bpmn:dataInputAssociation id="DIA_a_ref_a_sem"><bpmn:sourceRef>a_ref</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:serviceTask id="a_score" name="Расчёт confidence, проверка правил (цена ±30%, объём, бренд, категория)"><bpmn:incoming>SF_a_sem__a_score</bpmn:incoming><bpmn:outgoing>SF_a_score__a_end</bpmn:outgoing><bpmn:dataInputAssociation id="DIA_a_gold_a_score"><bpmn:sourceRef>a_gold</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="a_end" name="Результаты: топ-3 кандидата и score"><bpmn:incoming>SF_a_score__a_end</bpmn:incoming><bpmn:messageEventDefinition id="MED_a_end"/></bpmn:endEvent>
<bpmn:dataStoreReference id="a_ref" name="Эталонный каталог VitaStore (векторный индекс)" dataStoreRef="DS_a_ref"/>
<bpmn:dataStoreReference id="a_gold" name="Обучающая выборка (решения товароведов)" dataStoreRef="DS_a_gold"/>
<bpmn:sequenceFlow id="SF_a_start__a_exact" sourceRef="a_start" targetRef="a_exact"/>
<bpmn:sequenceFlow id="SF_a_exact__a_sem" sourceRef="a_exact" targetRef="a_sem"/>
<bpmn:sequenceFlow id="SF_a_sem__a_score" sourceRef="a_sem" targetRef="a_score"/>
<bpmn:sequenceFlow id="SF_a_score__a_end" sourceRef="a_score" targetRef="a_end"/>
</bpmn:process>
<bpmn:process id="Proc_P_sap" name="Загрузка мастер-данных" isExecutable="false">
<bpmn:startEvent id="e_start" name="Пакет соответствий получен"><bpmn:outgoing>SF_e_start__e_load</bpmn:outgoing><bpmn:messageEventDefinition id="MED_e_start"/></bpmn:startEvent>
<bpmn:serviceTask id="e_load" name="Загрузить соответствия и новые SKU в MDM (API)"><bpmn:incoming>SF_e_start__e_load</bpmn:incoming><bpmn:outgoing>SF_e_load__e_val</bpmn:outgoing></bpmn:serviceTask>
<bpmn:businessRuleTask id="e_val" name="Проверить мастер-данные: НДС, категория, ценовая зона"><bpmn:incoming>SF_e_load__e_val</bpmn:incoming><bpmn:outgoing>SF_e_val__e_end</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:endEvent id="e_end" name="Событие «каталог и цены магазина готовы»"><bpmn:incoming>SF_e_val__e_end</bpmn:incoming><bpmn:messageEventDefinition id="MED_e_end"/></bpmn:endEvent>
<bpmn:sequenceFlow id="SF_e_start__e_load" sourceRef="e_start" targetRef="e_load"/>
<bpmn:sequenceFlow id="SF_e_load__e_val" sourceRef="e_load" targetRef="e_val"/>
<bpmn:sequenceFlow id="SF_e_val__e_end" sourceRef="e_val" targetRef="e_end"/>
</bpmn:process>
<bpmn:process id="Proc_P_pos" name="Развёртывание кассы" isExecutable="false">
<bpmn:startEvent id="c_start" name="Событие из SAP получено"><bpmn:outgoing>SF_c_start__c_tenant</bpmn:outgoing><bpmn:messageEventDefinition id="MED_c_start"/></bpmn:startEvent>
<bpmn:serviceTask id="c_tenant" name="Создать магазин, загрузить каталог, цены, промо (дельтой, без FTP)"><bpmn:incoming>SF_c_start__c_tenant</bpmn:incoming><bpmn:outgoing>SF_c_tenant__c_test</bpmn:outgoing></bpmn:serviceTask>
